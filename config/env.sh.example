#!/usr/bin/env bash
# Configuration for ebpf-vthread-correlate
# Copy this file to env.sh and fill in the paths for your system.

# Path to libjvm.so — used by bpftrace to locate USDT probes.
# The path varies by platform and JDK build layout.
#
# x86_64 (typical):
#   LIBJVM_PATH=/path/to/jdk/lib/server/libjvm.so
#
# aarch64 (typical):
#   LIBJVM_PATH=/path/to/jdk/lib/server/libjvm.so
#
# Example (self-built OpenJDK from source, build dir):
#   x86_64: LIBJVM_PATH=/home/user/jdk/build/linux-x86_64-server-release/images/jdk/lib/server/libjvm.so
#   aarch64: LIBJVM_PATH=/home/user/jdk/build/linux-aarch64-server-release/images/jdk/lib/server/libjvm.so
LIBJVM_PATH=/path/to/your/libjvm.so

# JAVA_HOME — root of the self-built JDK image.
# test.sh uses $JAVA_HOME/bin/javac and $JAVA_HOME/bin/java.
#
# Example:
#   x86_64: JAVA_HOME=/home/user/jdk/build/linux-x86_64-server-release/images/jdk
#   aarch64: JAVA_HOME=/home/user/jdk/build/linux-aarch64-server-release/images/jdk
JAVA_HOME=/path/to/your/jdk
