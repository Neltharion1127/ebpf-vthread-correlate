#!/usr/bin/env bash
# config/env.sh.example — configuration for ebpf-vthread-correlate.
#
# RECOMMENDED: do not edit this by hand. Run ./setup.sh from the repo root —
# it downloads the pre-built vthread-trace JDK, verifies it, and generates
# config/env.sh with all three variables below filled in correctly.
#
# MANUAL (only if you built the JDK yourself instead of using ./setup.sh):
# copy this file to config/env.sh and fill in the paths for your system.

# Root of the vthread-trace JDK image.
# test.sh / profile-matrix.sh use $JAVA_HOME/bin/java and $JAVA_HOME/bin/javac.
#
# If you built OpenJDK from source, this is the images/jdk dir, e.g.:
#   x86_64:  JAVA_HOME=/home/user/jdk21u/build/linux-x86_64-server-release/images/jdk
#   aarch64: JAVA_HOME=/home/user/jdk21u/build/linux-aarch64-server-release/images/jdk
export JAVA_HOME=/path/to/your/jdk

# libjvm.so — bpftrace attaches the USDT probes by this path.
# Normally just $JAVA_HOME/lib/server/libjvm.so on both architectures.
export LIBJVM_PATH="$JAVA_HOME/lib/server/libjvm.so"

# Convenience alias used by run-usdt.sh / measure-oslevel.sh.
# Keep this equal to JAVA_HOME.
export JDK="$JAVA_HOME"
